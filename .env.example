SALES_COACH_DATABASE_URL=postgresql+psycopg2://sales_coach:sales_coach@localhost:5432/sales_coach
SALES_COACH_JWT_SECRET=please-change-this
# API Key 加密专用密钥（建议独立配置；留空则回退 JWT_SECRET 派生）
SALES_COACH_SECRET_KEY=
SALES_COACH_DEEPSEEK_API_KEY=
SALES_COACH_DEEPSEEK_BASE_URL=https://api.deepseek.com
SALES_COACH_DEEPSEEK_MODEL=deepseek-v4-flash

# Legacy MiniMax GroupId API compatibility. Leave empty if not required.
SALES_COACH_DEEPSEEK_GROUP_ID=

# 小米 MiMo 语音服务（ASR/TTS）。留空则语音功能自动隐藏，纯文字训练不受影响。
SALES_COACH_MIMO_API_KEY=
SALES_COACH_MIMO_BASE_URL=https://api.xiaomimimo.com
SALES_COACH_MIMO_ASR_MODEL=mimo-v2.5-asr
SALES_COACH_MIMO_TTS_MODEL=mimo-v2.5-tts
